@prefix : <https://example.org/ch/abstract-model/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:scheme a skos:ConceptScheme ;
  skos:prefLabel "Abstract model classification"@en ;
  skos:prefLabel "Abstrakte Fachmodell-Klassifikation"@de ;
  skos:prefLabel "Classification abstraite des maquettes"@fr ;
  skos:prefLabel "Classificazione astratta dei modelli"@it ;
  dcterms:title "Abstract model classification"@en ;
  dcterms:identifier "AbstractModelClassification" ;
  dcterms:creator "pragmatic-bim-public-rules" ;
  dcterms:issued "2026-09-03" ;
  dcterms:description "BIM discipline-model types (Fachmodelle) for deliverable classification. Notation is the model token in `{Projektnumber}_{DOMAIN}-{MODEL}_{Userdefined_text}.{ext}`. Domain membership is in the model-to-domain mapping."@en ;
  dcterms:description "BIM-Fachmodelltypen zur Klassifikation von Liefergegenständen. Notation ist das Modell-Token in `{Projektnumber}_{DOMAIN}-{MODEL}_{Userdefined_text}.{ext}`. Fachbereich-Zuordnung im Mapping Modell zu Fachbereich."@de ;
  dcterms:description "Types de maquettes disciplinaires BIM pour classer les livrables. La notation est le jeton de maquette dans `{Projektnumber}_{DOMAIN}-{MODEL}_{Userdefined_text}.{ext}`. L'appartenance au domaine est dans le mapping maquette vers domaine."@fr ;
  dcterms:description "Tipi di modello disciplinare BIM per classificare i deliverable. La notazione è il token del modello in `{Projektnumber}_{DOMAIN}-{MODEL}_{Userdefined_text}.{ext}`. L'appartenenza al dominio è nel mapping modello-dominio."@it ;
  skos:hasTopConcept
    :architecture, :storey-volume, :facade, :landscape, :surroundings, :furniture, :laboratory,
    :heating, :cooling, :ventilation, :plumbing, :underground-services,
    :concrete-structure, :steel-structure, :timber-structure, :reinforcement, :excavation-pit, :earthworks .

# --- Architecture domain (ARC-*) ---

:architecture a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "ARC" ;
  skos:prefLabel "Architecture"@en ;
  skos:prefLabel "Architektur"@de ;
  skos:prefLabel "Architecture"@fr ;
  skos:prefLabel "Architettura"@it ;
  skos:definition "Building architecture — spaces, components, and fit-out in one deliverable, including usable areas and space volumes for area verification."@en ;
  skos:definition "Gebäudearchitektur — Räume, Bauteile und Ausbau in einem Fachmodell, inklusive Nutzflächen und Raumvolumen für Flächennachweise."@de ;
  skos:definition "Architecture du bâtiment — locaux, composants et aménagement dans une maquette, y compris surfaces utiles et volumes de locaux pour les justificatifs de surfaces."@fr ;
  skos:definition "Architettura dell'edificio — spazi, componenti e finiture in un modello, comprese superfici utili e volumi dei locali per le verifiche di superficie."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-ARC_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-ARC_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-ARC_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-ARC_{Userdefined_text}.{ext}`."@it .

:storey-volume a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "GVM" ;
  skos:prefLabel "Storey volume"@en ;
  skos:prefLabel "Geschossvolumen"@de ;
  skos:prefLabel "Volume d'étage"@fr ;
  skos:prefLabel "Volume di piano"@it ;
  skos:definition "Gross volume per storey for massing studies, metrics, and urban-design verification."@en ;
  skos:definition "Bruttovolumen je Geschoss für Massenstudien, Kennwerte und städtebauliche Nachweise."@de ;
  skos:definition "Volume brut par étage pour études de masse, indicateurs et justificatifs urbanistiques."@fr ;
  skos:definition "Volume lordo per piano per studi di massa, indicatori e verifiche urbanistiche."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-GVM_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-GVM_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-GVM_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-GVM_{Userdefined_text}.{ext}`."@it .

:facade a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "FAS" ;
  skos:prefLabel "Facade"@en ;
  skos:prefLabel "Fassade"@de ;
  skos:prefLabel "Façade"@fr ;
  skos:prefLabel "Facciata"@it ;
  skos:definition "External envelope and facade build-up — cladding, openings, and facade-related layers, separate from the rest of the architecture deliverable."@en ;
  skos:definition "Aussenhülle und Fassadenaufbau — Bekleidung, Öffnungen und fassadenbezogene Schichten, getrennt vom übrigen Architekturmodell."@de ;
  skos:definition "Enveloppe extérieure et composition de façade — revêtements, ouvertures et couches liées à la façade, séparés du reste de la maquette d'architecture."@fr ;
  skos:definition "Involucro esterno e stratigrafia di facciata — rivestimenti, aperture e strati legati alla facciata, distinti dal resto del modello di architettura."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-FAS_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-FAS_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-FAS_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-FAS_{Userdefined_text}.{ext}`."@it .

:landscape a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "LAN" ;
  skos:prefLabel "Landscape"@en ;
  skos:prefLabel "Landschaft"@de ;
  skos:prefLabel "Paysage"@fr ;
  skos:prefLabel "Paesaggio"@it ;
  skos:definition "Surroundings and outdoor-space design — vegetation, paths, plazas, and designed external works."@en ;
  skos:definition "Umgebungs- und Aussenraumgestaltung — Vegetation, Wege, Plätze und gestaltete Aussenanlagen."@de ;
  skos:definition "Aménagement des abords et des espaces extérieurs — végétation, cheminements, places et aménagements paysagers."@fr ;
  skos:definition "Sistemazione degli spazi esterni — vegetazione, percorsi, piazze e opere a verde."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-LAN_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-LAN_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-LAN_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-LAN_{Userdefined_text}.{ext}`."@it .

:surroundings a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "UMG" ;
  skos:prefLabel "Surroundings"@en ;
  skos:prefLabel "Umgebung"@de ;
  skos:prefLabel "Contexte"@fr ;
  skos:prefLabel "Contesto"@it ;
  skos:definition "Existing stock, neighbouring buildings, and terrain as spatial context — not designed landscape works."@en ;
  skos:definition "Bestand, Nachbarbebauung und Terrain als räumlicher Kontext — nicht die gestaltete Landschaftsplanung."@de ;
  skos:definition "Existant, constructions voisines et terrain comme contexte spatial — distinct de l'aménagement paysager."@fr ;
  skos:definition "Esistente, edificato limitrofo e terreno come contesto spaziale — distinto dalla progettazione paesaggistica."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-UMG_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-UMG_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-UMG_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-UMG_{Userdefined_text}.{ext}`."@it .

:furniture a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "MOB" ;
  skos:prefLabel "Furniture"@en ;
  skos:prefLabel "Mobiliar"@de ;
  skos:prefLabel "Mobilier"@fr ;
  skos:prefLabel "Arredi"@it ;
  skos:definition "Furnishings and furniture for use, visualisation, and coordination — not specialist laboratory equipment."@en ;
  skos:definition "Einrichtung und Möblierung für Nutzung, Visualisierung und Koordination — keine Laborspezialausstattung."@de ;
  skos:definition "Ameublement et mobilier pour usage, visualisation et coordination — hors équipements de laboratoire."@fr ;
  skos:definition "Arredi e mobilio per uso, visualizzazione e coordinamento — esclusa l'attrezzatura di laboratorio."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-MOB_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-MOB_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-MOB_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-MOB_{Userdefined_text}.{ext}`."@it .

:laboratory a skos:Concept ;
  skos:inScheme :scheme ;
  skos:topConceptOf :scheme ;
  skos:notation "LAB" ;
  skos:prefLabel "Laboratory"@en ;
  skos:prefLabel "Labor"@de ;
  skos:prefLabel "Laboratoire"@fr ;
  skos:prefLabel "Laboratorio"@it ;
  skos:definition "Laboratory equipment and specialist lab fit-out — appliances, benches, and lab-specific installations."@en ;
  skos:definition "Laboreinrichtung und Speziallabor-Ausstattung — Geräte, Bänke und laborspezifische Einbauten."@de ;
  skos:definition "Équipements de laboratoire et aménagements spécialisés — appareils, paillasses et installations spécifiques."@fr ;
  skos:definition "Attrezzature di laboratorio e allestimenti speciali — apparecchi, banchi e installazioni specifiche."@it ;
  skos:scopeNote "File name: `{Projektnumber}_ARC-LAB_{Userdefined_text}.{ext}`."@en ;
  skos:scopeNote "Dateiname: `{Projektnumber}_ARC-LAB_{Userdefined_text}.{ext}`."@de ;
  skos:scopeNote "Nom de fichier: `{Projektnumber}_ARC-LAB_{Userdefined_text}.{ext}`."@fr ;
  skos:scopeNote "Nome file: `{Projektnumber}_ARC-LAB_{Userdefined_text}.{ext}`."@it .

