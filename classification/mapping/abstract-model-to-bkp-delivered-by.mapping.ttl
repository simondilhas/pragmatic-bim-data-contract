mod:reinforcement skos:closeMatch
  bkp:092, bkp:192, bkp:292, bkp:392, bkp:492, bkp:592 .

mod:excavation-pit skos:closeMatch
  bkp:092, bkp:192, bkp:292, bkp:392, bkp:492, bkp:592 .

mod:earthworks skos:closeMatch
  bkp:092, bkp:192, bkp:292, bkp:392, bkp:492, bkp:592 .

