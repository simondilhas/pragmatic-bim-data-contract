@prefix el: <https://example.org/pragmaticbim/elementplan-element/> .
@prefix swp: <https://example.org/abstract/wall-separator-product/> .
@prefix facp: <https://example.org/abstract/facade-covering-product/> .
@prefix wcp: <https://example.org/abstract/wall-covering-product/> .
@prefix fcp: <https://example.org/abstract/floor-covering-product/> .
@prefix ccp: <https://example.org/abstract/ceiling-covering-product/> .
@prefix fdp: <https://example.org/abstract/foundation-product/> .
@prefix ssp: <https://example.org/abstract/slab-separator-product/> .
@prefix rcp: <https://example.org/abstract/roof-covering-product/> .
@prefix clp: <https://example.org/abstract/column-product/> .
@prefix bmp: <https://example.org/abstract/beam-product/> .
@prefix srp: <https://example.org/abstract/stair-product/> .
@prefix rap: <https://example.org/abstract/railing-product/> .
@prefix wicp: <https://example.org/abstract/window-connector-product/> .
@prefix dcp: <https://example.org/abstract/door-connector-product/> .
@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix map: <https://example.org/mapping/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

map:elementplanElementsToProductsMapping a dcterms:Dataset ;
  dcterms:title "pragmaticBIM Elementplan elements to products mapping"@en ;
  dcterms:title "Mapping pragmaticBIM Elementplan Bauteile zu Produkten"@de ;
  dcterms:references el:scheme, swp:scheme, facp:scheme, wcp:scheme, fcp:scheme, ccp:scheme, fdp:scheme, ssp:scheme, rcp:scheme, clp:scheme, bmp:scheme, srp:scheme, rap:scheme, wicp:scheme, dcp:scheme ;
  dcterms:issued "2026-09-16" ;
  dcterms:description "Links each cost-relevant building element to the product SKOS scheme whose concepts differentiate it for pricing (pbs:productScheme), plus the catch-all product used as fallback when a model carries no product classification (skos:closeMatch). Any concept of the referenced scheme is a valid product for the element; all of them share the element reference quantity and price unit. Elements without a pbs:productScheme have no product vocabulary yet. Regenerate with scripts/generate_element_vocabulary.py."@en ;
  dcterms:description "Verknüpft jedes kostenrelevante Bauteil mit dem Produkt-SKOS-Schema, dessen Konzepte es für die Bepreisung differenzieren (pbs:productScheme), sowie mit dem Sammelprodukt als Rückfallwert, wenn ein Modell keine Produktklassifikation trägt (skos:closeMatch). Jedes Konzept des referenzierten Schemas ist ein gültiges Produkt für das Bauteil; alle teilen Referenzmenge und Verrechnungseinheit des Bauteils. Bauteile ohne pbs:productScheme haben noch kein Produktvokabular. Regenerieren mit scripts/generate_element_vocabulary.py."@de .

el:ARC-WALL-EXT pbs:productScheme swp:scheme ;
  pbs:referenceQuantity "NetSideArea" ;
  pbs:priceUnit "m2" ;
  skos:closeMatch swp:SWP-OTH .

el:ARC-WALL-INT-LB pbs:productScheme swp:scheme ;
  pbs:referenceQuantity "NetSideArea" ;
  pbs:priceUnit "m2" ;
  skos:closeMatch swp:SWP-OTH .

el:ARC-WALL-INT pbs:productScheme swp:scheme ;
