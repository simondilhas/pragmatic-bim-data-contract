facp:FaCP-RETROFIT-OVERCLADDING skos:closeMatch bkp:215_5, bkp:226_2 .

facp:FaCP-BIPV-INTEGRATED skos:closeMatch bkp:215_5, bkp:231 ;
  skos:relatedMatch bkp:232 .

facp:FaCP-HPL-PANEL skos:closeMatch bkp:215_5 ;
