@prefix rcp: <https://example.org/abstract/roof-covering-product/> .
@prefix rn: <https://example.org/abstract/building-space-name-classification/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/mapping/> .

map:roofCoveringProductsToOutdoorRoomNameMapping a dcterms:Dataset ;
  dcterms:title "Roof covering products to outdoor room name mapping"@en ;
  dcterms:title "Mapping Dachbekleidungsprodukte zu Aussenraumnamen"@de ;
  dcterms:references rcp:scheme, rn:scheme ;
  dcterms:issued "2026-09-22" ;
  dcterms:description "Compatibility links from roof covering products (RCP) to outdoor room names on flat roofs and roof platforms (RN-OUT-*). Uses skos:relatedMatch: a roof product suggests typical outdoor space types where that build-up is commonly used. Space use remains assigned via room name; roof system remains assigned via RCP. Layer narrowers are not mapped. Not bijective — PBS rules disambiguate."@en ;
  dcterms:description "Kompatibilitaetsverknuepfungen von Dachbekleidungsprodukten (RCP) zu Aussenraumnamen auf Flachdaechern und Dachplattformen (RN-OUT-*). skos:relatedMatch: ein Dachprodukt nennt typische Aussenraumtypen fuer diesen Aufbau. Raumnutzung bleibt ueber Raumnamen, Dachsystem ueber RCP. Schicht-narrower sind nicht gemappt. Nicht bijektiv — Disambiguierung in PBS-Regeln."@de .

# --- Flat waterproofing systems ---

rcp:RCP-FLAT-BITUMEN skos:relatedMatch rn:RN_OUT_RWM, rn:RN_OUT_RTR, rn:RN_OUT_TEQ .

rcp:RCP-FLAT-SINGLE-PLY skos:relatedMatch rn:RN_OUT_RWM, rn:RN_OUT_RTR, rn:RN_OUT_TEQ .

rcp:RCP-FLAT-LIQUID skos:relatedMatch rn:RN_OUT_RWM, rn:RN_OUT_RTR, rn:RN_OUT_TEQ .

# --- Green roofs ---

rcp:RCP-GREEN-EXTENSIVE skos:relatedMatch rn:RN_OUT_GRN, rn:RN_OUT_RWM .

rcp:RCP-GREEN-INTENSIVE skos:relatedMatch rn:RN_OUT_GRN, rn:RN_OUT_RTR, rn:RN_OUT_GDN .

# --- PV roof ---

rcp:RCP-PV-ROOF skos:relatedMatch rn:RN_OUT_TEQ, rn:RN_OUT_RWM .
